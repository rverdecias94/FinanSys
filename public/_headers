# Service worker y manifest: nunca cachear en CDN/navegador agresivo,
# para que la PWA detecte deploys nuevos lo antes posible.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Netlify-CDN-Cache-Control: no-store

/workbox-*.js
  Cache-Control: no-cache, no-store, must-revalidate
  Netlify-CDN-Cache-Control: no-store

/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate
  Netlify-CDN-Cache-Control: no-store

# Iconos PWA versionados (-v3): cacheables; al cambiar de marca se sube el sufijo.
/pwa-*-v3.png
  Cache-Control: public, max-age=31536000, immutable
/maskable-icon-*-v3.png
  Cache-Control: public, max-age=31536000, immutable
/favicon-v3.ico
  Cache-Control: public, max-age=31536000, immutable
/apple-touch-icon-*-v3.png
  Cache-Control: public, max-age=31536000, immutable
